@PACKAGE_INIT@

include( CMakeFindDependencyMacro )

find_dependency( Boost 1.86.0 REQUIRED
  COMPONENTS
    container
    iostreams
    json
    locale
    program_options
    thread
    url
)

set( with-secp256k1 @with-secp256k1@ )

if ( with-secp256k1 )
  find_dependency( libsecp256k1 0.7.0 REQUIRED )
endif()

set( with-ultrafast @with-ultrafast@ )

if ( with-ultrafast )
  find_dependency( secp256k1-fast 4.3.0 REQUIRED )
  find_dependency( Threads REQUIRED )
  if ( NOT TARGET ufsecp::ufsecp )
    find_path( ufsecp_INCLUDE_DIR
      NAMES
        ufsecp_libbitcoin.h
      PATHS
        "${PACKAGE_PREFIX_DIR}/include"
      REQUIRED
    )
    find_library( ufsecp_LIBRARY
      NAMES
        ufsecp
      PATHS
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
        "${PACKAGE_PREFIX_DIR}/lib"
      REQUIRED
    )
    add_library( ufsecp::ufsecp UNKNOWN IMPORTED )
    set_target_properties( ufsecp::ufsecp
      PROPERTIES
        IMPORTED_LOCATION "${ufsecp_LIBRARY}"
        INTERFACE_LINK_LIBRARIES Threads::Threads
    )
  endif()
endif()

include( "${CMAKE_CURRENT_LIST_DIR}/libbitcoin-system-targets.cmake" )

check_required_components(@PROJECT_NAME@)
